# Salin ke .env.local untuk development, dan isi yang sama di Vercel → Settings → Environment Variables.

# --- Akun induk (hanya akun GitHub ini yang bisa masuk) ---
ALLOWED_GITHUB_LOGIN=username-github-anda
# Opsional tapi disarankan: ID numerik GitHub (tidak berubah walau username diganti).
# Cek di https://api.github.com/users/<username>
ALLOWED_GITHUB_ID=

# --- GitHub OAuth App (github.com/settings/developers → New OAuth App) ---
# Callback URL: https://<domain-anda>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Google OAuth (console.cloud.google.com → APIs & Services) ---
# Aktifkan "Google Drive API". Buat OAuth client tipe "Web application".
# Authorized redirect URI: https://<domain-anda>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default drive.file (non-sensitif, cukup untuk membaca kuota).
# GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# --- Rahasia (buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ---
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# --- Upstash Redis (Vercel → Storage → Upstash for Redis; terisi otomatis) ---
# Kosongkan saat development lokal: data disimpan di .data/db.json
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opsional: paksa origin publik (mis. bila memakai domain kustom di balik proxy)
# APP_URL=https://drive.domainanda.com
